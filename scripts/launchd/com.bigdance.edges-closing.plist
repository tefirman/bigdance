<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bigdance.edges-closing</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/launchd/run_edges.sh</string>
    <string>closing</string>
  </array>
  <!-- every 15 minutes; a no-op (no API call) unless a logged bet tips within 20 min -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/bigdance-bets/logs/closing.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/bigdance-bets/logs/closing.log</string>
</dict>
</plist>
